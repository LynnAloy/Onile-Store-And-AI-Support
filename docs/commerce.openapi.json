            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "classification": {
            "type": "string",
            "enum": [
              "OTC",
              "RX",
              "UNKNOWN"
            ]
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "APPROVED",
              "PENDING"
            ]
          },
