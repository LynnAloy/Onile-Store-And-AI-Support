            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "ledgerId": {
            "type": "string"
          }
        },
        "required": [
          "paymentId",
          "orderId",
          "amount",
          "currency",
          "paidAt",
          "ledgerId"
        ],
        "additionalProperties": false
