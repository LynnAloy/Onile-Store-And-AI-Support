          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expectedStock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "required": [
          "expectedVersion",
          "stock",
          "reason",
          "expectedStock"
        ],
        "additionalProperties": false
