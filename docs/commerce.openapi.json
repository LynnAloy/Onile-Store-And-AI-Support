      },
      "MedicineEvidenceUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedVersion",
          "qualificationVersion",
          "categories",
          "ingredients",
          "indications",
          "source",
          "maxUnitsPerOrder"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "qualificationVersion": {
            "type": "integer",
            "minimum": 0
