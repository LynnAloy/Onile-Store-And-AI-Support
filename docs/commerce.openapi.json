      "Audit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "admin_id": {
            "type": "string"
          },
          "medicine_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "before_json": {
            "type": "string"
          },
          "after_json": {
            "type": "string"
          },
          "created_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "admin_id",
          "medicine_id",
          "before_json",
          "after_json",
          "created_at"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "NOT_APPLIED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "ModelConfigUpdate": {
        "type": "object",
        "required": [
          "expectedVersion",
          "model",
          "endpoint"
        ],
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "protocol": {
            "type": "string",
            "enum": [
              "ollama",
              "openai"
            ]
          },
          "apiKey": {
            "type": "string",
            "maxLength": 500,
            "writeOnly": true
          },
          "clearApiKey": {
            "type": "boolean"
          }
