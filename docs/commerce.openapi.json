                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Validation, authentication, business refusal or uncertain transaction result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Validation, authentication, business refusal or uncertain transaction result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Validation, authentication, business refusal or uncertain transaction result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Execute"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/admin/ai-config": {
      "get": {
        "summary": "Read chat model and endpoint",
        "responses": {
          "200": {
            "description": "Administrator-only Ollama configuration; no-store"
          },
          "403": {
            "description": "Administrator role required"
          }
        }
      },
      "put": {
        "summary": "Atomically save versioned model and endpoint; new model calls reload configuration",
        "responses": {
          "200": {
            "description": "Administrator-only Ollama configuration; no-store"
          },
          "403": {
            "description": "Administrator role required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelConfigUpdate"
              }
            }
          }
        }
      }
    },
    "/api/admin/medicines/{id}/evidence": {
      "get": {
        "summary": "Read current or stale administrator evidence",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reviewed evidence with version/qualificationVersion, or STALE, or version=0 when absent"
          },
          "403": {
            "description": "ADMIN membership required"
          },
          "409": {
            "description": "Qualification/evidence version conflict"
          }
        }
      },
      "put": {
        "summary": "Explicit administrator review; update audited evidence with optimistic versions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reviewed evidence with version/qualificationVersion, or STALE, or version=0 when absent"
          },
          "403": {
            "description": "ADMIN membership required"
          },
          "409": {
            "description": "Qualification/evidence version conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MedicineEvidenceUpdate"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PolicyUpdate": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "perOrderLimit": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          },
          "dailyLimit": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "writeOnly": true
          }
        },
        "required": [
          "enabled",
          "perOrderLimit",
          "dailyLimit",
          "expectedVersion"
        ],
        "additionalProperties": false
      },
      "Policy": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "perOrderLimit": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          },
          "dailyLimit": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "dailySpent": {
            "type": "number",
            "minimum": 0
          },
          "dailyRemaining": {
            "type": "number",
            "minimum": 0
          },
          "budgetDay": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string",
            "enum": [
              "PST (UTC-08:00)"
            ]
          }
        },
        "required": [
          "enabled",
          "perOrderLimit",
          "dailyLimit",
          "version",
          "dailySpent",
          "dailyRemaining",
          "budgetDay",
          "timeZone"
        ],
        "additionalProperties": false
      },
      "Turn": {
        "type": "object",
        "properties": {
          "turnId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{36}$"
          },
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "turnId",
          "conversationId",
          "message"
        ],
        "additionalProperties": false
      },
      "Item": {
        "type": "object",
        "properties": {
          "medicineId": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "required": [
          "medicineId",
          "quantity"
        ],
        "additionalProperties": false
      },
      "Execute": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Review": {
        "type": "object",
