  "components": {
    "securitySchemes": {
      "UserToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "USER session only. Payment token is not a Bearer identity."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "NOT_APPLIED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "expectedVersion"
        ]
      },
      "Authorize": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "UTF-8 <=72 bytes; never trim, log or persist plaintext."
          }
        },
        "required": [
          "expectedVersion",
          "password"
        ]
      },
      "Line": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "medicineId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,7})\\.[0-9]{2}$",
            "example": "10.00"
          },
          "qualificationVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "medicineId",
          "name",
          "quantity",
          "price",
          "qualificationVersion"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paymentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "orderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,7})\\.[0-9]{2}$",
            "example": "10.00"
          },
          "currency": {
            "type": "string",
            "enum": [
              "CNY"
            ]
          },
          "paidAt": {
            "type": "integer",
            "minimum": 0
