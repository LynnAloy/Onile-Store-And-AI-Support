  "components": {
    "schemas": {
      "ConversationView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "createdAt": {
            "type": "integer",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "integer",
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "createdAt",
          "updatedAt"
        ],
        "title": "ConversationView"
      },
      "CreateConversation": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Title",
            "default": "新对话"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateConversation"
      },
      "DraftIntent": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DraftItem"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "DraftIntent"
      },
      "DraftItem": {
        "properties": {
          "medicineId": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Medicineid"
          },
          "quantity": {
            "type": "integer",
            "maximum": 99.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "medicineId",
          "quantity"
        ],
        "title": "DraftItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/TurnView"
            },
            "type": "array",
            "title": "Turns"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "turns"
        ],
        "title": "HistoryView"
      },
      "MessageRequest": {
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "title": "Requestid"
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "purchaseIntent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftIntent"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "message"
        ],
        "title": "MessageRequest"
      },
      "TurnView": {
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "title": "Requestid"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "assistant": {
            "type": "string",
            "title": "Assistant"
          },
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "completed",
              "failed",
              "interrupted"
            ],
            "title": "Status"
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errorcode"
          },
          "createdAt": {
            "type": "integer",
            "title": "Createdat"
          },
          "personalizationApplied": {
            "type": "boolean",
            "title": "Personalizationapplied",
            "default": false
          },
          "profileRevision": {
            "type": "integer",
            "title": "Profilerevision",
            "default": 0
          },
          "citations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Citations"
          },
          "retrieval": {
            "additionalProperties": true,
            "type": "object",
            "title": "Retrieval"
          },
          "toolEvents": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Toolevents"
          }
        },
        "type": "object",
        "required": [
          "requestId",
          "message",
          "assistant",
          "status",
          "errorCode",
          "createdAt"
        ],
        "title": "TurnView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ErrorView": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorView",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
