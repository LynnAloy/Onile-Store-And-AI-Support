# Copy these into your shell environment; .env is not auto-loaded.
JAVA_BASE_URL=http://127.0.0.1:8080
# Must equal Java AI_SERVICE_KEY. At least 32 random characters, server-side only.
AI_SERVICE_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:1.5b
# Optional for an authenticated Ollama-compatible gateway.
OLLAMA_API_KEY=
# AI conversations only. No medicine/order/wallet tables exist in this database.
AI_DATABASE_PATH=./data/conversations.db
MODEL_TIMEOUT_SECONDS=120
MODEL_READ_TIMEOUT_SECONDS=30
MODEL_TEMPERATURE=0.2
CONTEXT_CHAR_LIMIT=6000
CONTEXT_TURN_LIMIT=10
MODEL_OUTPUT_CHAR_LIMIT=12000
KNOWLEDGE_DATABASE_PATH=./data/knowledge.db
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_TIMEOUT_SECONDS=60
RAG_ENABLED=true
RAG_MIN_SIMILARITY=0.55
# Optional extra model calls; default off, never treated as knowledge evidence.
RAG_QUERY_REWRITE=false
RAG_HYDE=false
RAG_LLM_RERANK=false
