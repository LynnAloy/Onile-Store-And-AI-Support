# Set these as shell environment variables; Spring does not auto-load .env files.
DB_URL=jdbc:mysql://localhost:3306/DeepSeekDoc?useSSL=false&useUnicode=true&characterEncoding=utf-8&serverTimezone=GMT%2B8
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_SECONDS=7200
# Generate a random secret of at least 32 characters. Keep it on Java/Python servers only.
AI_SERVICE_KEY=
# One-time, local migration after applying V001. Disable again after it succeeds.
MIGRATE_LEGACY_PASSWORDS=false
